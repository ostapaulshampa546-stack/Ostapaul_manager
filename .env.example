# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé serveur uniquement : webhooks de paiement, cron. Ne JAMAIS l'exposer au navigateur.
SUPABASE_SERVICE_ROLE_KEY=

# URL publique de l'application (QR codes des cartes, tables, reçus)
NEXT_PUBLIC_APP_URL=https://app.ostapaul.com

# --- Intelligence artificielle (Claude) — serveur uniquement ---
ANTHROPIC_API_KEY=

# --- Mobile Money via agrégateur pawaPay (Orange Money, Airtel Money, M-Pesa RDC) ---
# https://docs.pawapay.io — sandbox : https://api.sandbox.pawapay.io
PAWAPAY_API_URL=https://api.sandbox.pawapay.io
PAWAPAY_API_TOKEN=

# --- SMS / WhatsApp via Twilio (optionnel) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# Secret partagé pour /api/cron (planificateur externe, ex. Vercel Cron)
CRON_SECRET=
